<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradient"
    tools:context=".SignUp">

    <ImageView
        android:id="@+id/logo"
        android:layout_width="327dp"
        android:layout_height="338dp"
        android:background="@drawable/sovereign_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="25dp"
        />
    <TextView
        android:id="@+id/welcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome!"
        android:fontFamily="@font/montagu_slab_bold"
        android:textColor="@color/text_color"
        android:textSize="42sp"
        app:layout_constraintTop_toBottomOf="@+id/logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />

    <LinearLayout
        android:layout_width="363dp"
        android:layout_height="401dp"
        app:layout_constraintTop_toBottomOf="@+id/welcome"
        android:padding="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:orientation="vertical"
        android:background="@drawable/bg_layer_10opacity"
        >
    <LinearLayout
        android:id="@+id/layer1"
        android:layout_width="337dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/fieldcontainer1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:orientation="vertical"
            >
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID Number"
                android:textSize="15sp"
                android:fontFamily="@font/montagu_slab_bold"
                android:textColor="@color/white"

                />
            <EditText
                android:id="@+id/ID_No"
                android:layout_width="158dp"
                android:layout_height="25dp"
                android:hint="ID Number"
                android:inputType="text"
                android:background="@drawable/input_background"
                android:textColorHint="#878787"
                android:padding="5dp"
                android:textSize="13sp"/>

        </LinearLayout>
        <LinearLayout
            android:id="@+id/fieldcontainer2"
            android:layout_width="wrap_content"
            android:orientation="vertical"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Department"
                android:textSize="15sp"
                android:fontFamily="@font/montagu_slab_bold"
                android:textColor="@color/white"
                />
            <Spinner
                android:id="@+id/department"
                android:layout_width="158dp"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/white"
                app:layout_constraintTop_toBottomOf="@+id/lastname"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </LinearLayout>

    </LinearLayout>
        <LinearLayout
            android:id="@+id/layer2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/fieldcontainer3"
                android:layout_width="wrap_content"
                android:orientation="vertical"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Firstname"
                    android:textSize="15sp"
                    android:fontFamily="@font/montagu_slab_bold"
                    android:textColor="@color/white"
                    />
                <EditText
                    android:id="@+id/firstname"
                    android:layout_width="158dp"
                    android:layout_height="25dp"
                    android:hint="First Name"
                    android:background="@drawable/input_background"
                    android:inputType="text"
                    android:textColorHint="#878787"
                    android:padding="5dp"
                    android:textSize="13sp"
                    />

            </LinearLayout>
            <LinearLayout
                android:id="@+id/fieldcontainer4"
                android:layout_width="wrap_content"
                android:orientation="vertical"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lastname"
                    android:textSize="15sp"
                    android:fontFamily="@font/montagu_slab_bold"
                    android:textColor="@color/white"
                    />
                <EditText
                    android:id="@+id/lastname"
                    android:layout_width="158dp"
                    android:layout_height="25dp"
                    android:hint="Last Name"
                    android:inputType="text"
                    android:textColorHint="#878787"
                    android:background="@drawable/input_background"
                    android:textSize="13sp"
                    android:padding="5dp"
                    />
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email Address"
            android:textSize="15sp"
            android:fontFamily="@font/montagu_slab_bold"
            android:textColor="@color/white"
            />
        <EditText
            android:id="@+id/email_add"
            android:layout_width="337dp"
            android:layout_height="25dp"
            android:hint="Email Address"
            android:background="@drawable/input_background"
            android:inputType="text"
            android:textColorHint="#878787"
            android:textSize="13sp"
            android:padding="5dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Username"
            android:textSize="15sp"
            android:fontFamily="@font/montagu_slab_bold"
            android:textColor="@color/white"
            />
        <EditText
            android:id="@+id/username"
            android:layout_width="337dp"
            android:layout_height="25dp"
            android:hint="Username"
            android:background="@drawable/input_background"
            android:inputType="text"
            android:textSize="13sp"
            android:textColorHint="#878787"
            android:padding="5dp"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textSize="15sp"
            android:fontFamily="@font/montagu_slab_bold"
            android:textColor="@color/white"
            />
        <EditText
            android:id="@+id/password"
            android:layout_width="337dp"
            android:layout_height="25dp"
            android:hint="Password"
            android:inputType="text|textPassword"
            android:background="@drawable/input_background"
            android:textColorHint="#878787"
            android:padding="5dp"
            android:textSize="13sp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirm Password"
            android:textSize="15sp"
            android:fontFamily="@font/montagu_slab_bold"
            android:textColor="@color/white"
            />
        <EditText
            android:id="@+id/confirm_pass"
            android:layout_width="337dp"
            android:layout_height="25dp"
            android:hint="Confirm Password"
            android:inputType="text|textPassword"
            android:textColorHint="#878787"
            android:textSize="13sp"
            android:background="@drawable/input_background"
            android:padding="5dp"
            />
        <CheckBox
            android:id="@+id/showpass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/white"
            android:layout_gravity="start"
            />
        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="30dp"
            android:layout_gravity="center">
            <ImageButton
                android:id="@+id/sign_up_button"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/button_selector"
                android:contentDescription="SignUp Button"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign Up"
                android:textSize="12sp"
                android:textColor="@color/text_color"
                android:layout_gravity="center"
                android:fontFamily="@font/montagu_slab"
                />
        </FrameLayout>

    </LinearLayout>






</androidx.constraintlayout.widget.ConstraintLayout>