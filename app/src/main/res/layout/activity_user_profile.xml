<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".UserProfile"
    android:background="@drawable/background_gradient">


    <TextView
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/trahu"
        android:text="Account Details"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="25sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.005" />
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/sovereign_logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:contentDescription="Logo"
        android:alpha=".3"/>

    <LinearLayout
        android:id="@+id/details"
        android:layout_width="338dp"
        android:layout_height="312dp"
        android:layout_marginTop="50dp"
        android:background="@drawable/round_superlightopacity"
        android:orientation="vertical"
        android:padding="10dp"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@+id/buttons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.493"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/label"
     >

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="30dp"
            android:layout_marginBottom="20dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/trahu"
                android:text="Username"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montagu_slab"
                android:text="Username"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="30dp"
            android:layout_marginBottom="20dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/trahu"
                android:text="ID Number"
                android:textColor="@color/white"
                android:textSize="15sp"

                />

            <TextView
                android:id="@+id/id_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montagu_slab"
                android:text="ID Number"
                android:textColor="@color/white"
                android:textSize="13sp"

                />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="30dp"
            android:layout_marginBottom="20dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/trahu"
                android:text="Department"
                android:textColor="@color/white"
                android:textSize="15sp"

                />

            <TextView
                android:id="@+id/department"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montagu_slab"
                android:text="Department"
                android:textColor="@color/white"
                android:textSize="13sp"

                />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="30dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/trahu"
                    android:text="First Name"
                    android:textColor="@color/white"
                    android:textSize="15sp"

                    />

                <TextView
                    android:id="@+id/firstname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montagu_slab"
                    android:text="First Name"
                    android:textColor="@color/white"
                    android:textSize="13sp"

                    />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/trahu"
                    android:text="Last Name"
                    android:textColor="@color/white"
                    android:textSize="15sp"

                    />

                <TextView
                    android:id="@+id/lastname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montagu_slab"
                    android:text="Last Name"
                    android:textColor="@color/white"
                    android:textSize="13sp"

                    />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="30dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/trahu"
                android:text="Email Address"
                android:textColor="@color/white"
                android:textSize="15sp"

                />

            <TextView
                android:id="@+id/email_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montagu_slab"
                android:text="Email Address"
                android:textColor="@color/white"
                android:textSize="13sp"

                />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@+id/details"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="5dp"
        android:layout_gravity="center"
        >

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            >
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/update"
                style="@style/CustomButtons"
                android:contentDescription="Update"


                />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/CustomButtonsTextDetails"

                android:text="Update"


                />
        </FrameLayout>
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/logout"
                style="@style/CustomButtons"
                android:contentDescription="Logout"

                />

            <androidx.appcompat.widget.AppCompatTextView
                style="@style/CustomButtonsTextDetails"
                android:text="Logout" />
        </FrameLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/buttons2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/buttons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="5dp"

        >
        <FrameLayout
            android:id="@+id/edit_user_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:visibility="visible"

            >
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/edit_user_button"
                style="@style/CustomButtons"
                android:contentDescription="Edit User Details"

                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/edit_user_label"
                android:text="Edit User"
                style="@style/CustomButtonsTextDetails"


                />
        </FrameLayout>
        <FrameLayout
            android:id="@+id/edit_dept_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="visible"
            >
            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/edit_dept_button"
                style="@style/CustomButtons"
                android:contentDescription="Edit Deprtments"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/edit_dept_label"
                android:text="Edit Department"

                style="@style/CustomButtonsTextDetails"
                />
        </FrameLayout>
    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>
