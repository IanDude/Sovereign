<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ranking_update">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_gradient">

        <!-- Table-like structure for Departments and Points -->
        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/inputContainer"
            android:padding="16dp">

            <TableLayout
                android:id="@+id/tableLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:padding="8dp">

                <!-- Header Row -->
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="2">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Departments"
                        android:gravity="center"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="#8B0000"
                        android:fontFamily="@font/trahu"
                        android:padding="8dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Points"
                        android:fontFamily="@font/trahu"
                        android:gravity="center"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:background="#8B0000"
                        android:padding="8dp" />
                </TableRow>

                <!-- Example Rows -->
                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="2">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CICT"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:padding="8dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="15,900"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:padding="8dp" />
                </TableRow>

                <TableRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="2">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CJJ"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:padding="8dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="14,000"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:padding="8dp" />
                </TableRow>
            </TableLayout>
        </ScrollView>

        <!-- Input Section -->
        <LinearLayout
            android:id="@+id/inputContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintTop_toBottomOf="@id/scrollView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Input for Department -->
            <EditText
                android:id="@+id/editDepartment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColorHint="@color/hint_color"
                android:hint="Enter Department"
                android:padding="8dp"
                android:background="@drawable/round_superlightopacity"
                android:textColor="@color/white" />

            <!-- Input for Points -->
            <EditText
                android:id="@+id/editPoints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Points"
                android:padding="8dp"
                android:inputType="number"
                android:textColorHint="@color/hint_color"
                android:background="@drawable/round_superlightopacity"
                android:layout_marginTop="8dp"
                android:textColor="@color/white" />

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="8dp">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    >

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/btnAdd"
                        android:layout_width="90dp"
                        android:contentDescription="Add Button"
                        style="@style/CustomButtons"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        android:text="Add"
                        style="@style/CustomButtonsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </FrameLayout>
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp">

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/btnEdit"
                        android:layout_width="90dp"
                        android:contentDescription="Edit"
                        style="@style/CustomButtons"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/CustomButtonsText"
                        android:text="Edit"/>
                </FrameLayout>
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <androidx.appcompat.widget.AppCompatImageButton
                        android:id="@+id/btnDelete"
                        style="@style/CustomButtons"
                        android:layout_width="90dp"
                        android:contentDescription="Delete"
                        android:text="Delete"/>
                    <androidx.appcompat.widget.AppCompatTextView
                        style="@style/CustomButtonsText"
                        android:text="Delete"/>

                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>