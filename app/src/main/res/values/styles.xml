<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Custom Bottom Navigation View Style -->
    <style name="CustomBottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconSize">10dp</item> <!-- Set a visible icon size -->
        <item name="itemTextAppearanceActive">@style/CustomBottomNavText</item>
        <item name="itemTextAppearanceInactive">@style/CustomBottomNavText</item>
    </style>

    <!-- Custom Text Appearance for Bottom Navigation -->
    <style name="CustomBottomNavText" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">10sp</item> <!-- Reduced text size -->

    </style>
    <style name="CustomPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@color/bg_red</item>
    </style>


    <style name="CustomButtons" parent="Widget.AppCompat.ImageButton">
        <item name="android:background">@drawable/button_selector</item>
        <item name="android:layout_width">120dp</item>
        <item name="android:layout_height">40dp</item>
    </style>

    <style name="CustomButtonsText" parent="Widget.AppCompat.TextView">

        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:textSize">20sp</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">@font/montagu_slab_bold</item>
        <item name="android:textColor">@color/text_color</item>
        <item name="android:layout_gravity">center</item>
    </style>


    <style name="CustomTabText" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">18sp</item>
        <item name="textAllCaps">false</item>
    </style>
</resources>
